# ===================================================
# Local Service Finder - Environment Configuration
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB: mongodb://localhost:27017/servicefinder
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/servicefinder?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/servicefinder

# JWT Authentication Secret (Set a secure secret in production)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Google Gemini AI Integration (For smart matching, recommendations, and pricing)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Fast2SMS OTP Service (Optional for local development; OTPs are logged to console if key is omitted)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_URL=https://www.fast2sms.com/dev/bulkV2
